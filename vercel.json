{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ui": { "root": "web/" },
    "api": { "root": "src/", "entrypoint": "tennisdb.api.app:app" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "ui" } }
  ]
}
