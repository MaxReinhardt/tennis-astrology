# Supabase Postgres connection string, e.g.:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Use the direct/session connection (port 5432), not the transaction pooler
# (port 6543): migrations need real transactions and multi-statement scripts.
SUPABASE_DB_URL=

# Supabase project URL and service-role key (used by the REST/storage client, if needed)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# GitHub repos (owner/name) for the Sackmann match data. The upstream
# JeffSackmann/tennis_atp and JeffSackmann/tennis_wta repos disappeared from
# GitHub in mid-2026; the defaults point at the freshest surviving forks.
# Override here if the upstream returns or a better mirror appears.
SACKMANN_ATP_REPO=
SACKMANN_WTA_REPO=

# Serving connection for the deployed API: Supabase's *transaction pooler* string
# (port 6543), ideally for a read-only role. Unset -> the API reads the local warehouse.
SUPABASE_READ_URL=

# Enables natural-language questions in the web UI (POST /api/translate).
ANTHROPIC_API_KEY=

# Lets visitors file a missing strategy as a GitHub issue (POST /api/strategy-requests).
# Use a fine-grained token limited to GITHUB_REPOSITORY with Issues: read and write only.
GITHUB_TOKEN=
GITHUB_REPOSITORY=MaxReinhardt/tennis-astrology
