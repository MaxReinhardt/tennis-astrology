# Supabase Postgres connection string, e.g.:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Use the direct/session connection (port 5432), not the transaction pooler
# (port 6543): migrations need real transactions and multi-statement scripts.
SUPABASE_DB_URL=

# Supabase project URL and service-role key (used by the REST/storage client, if needed)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# GitHub repos (owner/name) for the Sackmann match data. The upstream
# JeffSackmann/tennis_atp and JeffSackmann/tennis_wta repos disappeared from
# GitHub in mid-2026; the defaults point at the freshest surviving forks.
# Override here if the upstream returns or a better mirror appears.
SACKMANN_ATP_REPO=
SACKMANN_WTA_REPO=
